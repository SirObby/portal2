+
+// Bind the finished mapping to exact demo/video bytes, including muxer output.
+static std::string alignmentSHA256(const std::string &path) {
+	FILE *file = fopen(path.c_str(), "rb");
+	AVSHA *sha = av_sha_alloc();
+	if (!file || !sha || av_sha_init(sha, 256) != 0) {
+		if (file) fclose(file);
+		av_free(sha);
+		return "";
+	}
+	uint8_t buffer[65536], digest[32];
+	size_t size;
+	while ((size = fread(buffer, 1, sizeof buffer, file)) != 0) av_sha_update(sha, buffer, size);
+	bool ok = !ferror(file);
+	fclose(file);
+	av_sha_final(sha, digest);
+	av_free(sha);
+	if (!ok) return "";
+	char hex[65];
+	for (int i = 0; i < 32; ++i) snprintf(hex + i * 2, 3, "%02x", digest[i]);
+	return hex;
+}
