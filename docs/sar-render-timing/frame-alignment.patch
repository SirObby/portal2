+void Renderer::RecordDemoInterpolation(int slot, int targetTick, int previousTick, int nextTick) {
+	if (!sar_render_alignment.GetBool() || slot < 0 || slot >= 2) return;
+	g_demoInterpolation[slot] = {true, targetTick, previousTick, nextTick, engine->GetClientTime()};
+}
